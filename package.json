{
  "name": "hireright",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:backend": "cd backend && uvicorn main:app --host 0.0.0.0 --port 8001 --reload",
    "dev:agent": "cd agent && python agent.py dev",
    "dev:evaluator": "cd evaluator && npm run dev",
    "dev:ml": "cd ml && python server.py",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:agent\" \"npm run dev:evaluator\" \"npm run dev:ml\" \"npm run dev\"",
    "build": "npm install && npx prisma generate && npx prisma db push --skip-generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "ml:export": "npx tsx scripts/exportTrainingData.ts",
    "ml:train": "cd ml && pip install -r requirements.txt && python train.py",
    "ml:server": "cd ml && python server.py"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1104.0",
    "@aws-sdk/s3-request-presigner": "^3.1104.0",
    "@deepgram/sdk": "^5.7.0",
    "@livekit/components-react": "^2.9.24",
    "@livekit/components-styles": "^1.2.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@monaco-editor/react": "^4.7.0",
    "@paypal/react-paypal-js": "^10.3.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^10.70.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "bcryptjs": "^3.0.3",
    "canvas": "^3.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "inngest": "^4.18.0",
    "jsonwebtoken": "^9.0.3",
    "livekit-client": "^2.22.0",
    "livekit-server-sdk": "^2.17.0",
    "lucide-react": "^1.28.0",
    "mammoth": "^1.12.1",
    "next": "^16.3.5",
    "nodemailer": "^9.0.3",
    "openai": "^6.49.0",
    "pdf-parse": "^1.1.1",
    "pdf2pic": "^3.2.0",
    "pdfmake": "^0.3.11",
    "pg": "^8.23.0",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.10.1",
    "speakeasy": "^2.0.0",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfmake": "^0.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/speakeasy": "^2.0.10",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
