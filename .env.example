# ============================================
# TECHCITTA - Environment Variables Example
# ============================================

# --------------------------------------------
# CORE
# --------------------------------------------
DATABASE_URL="postgresql://neondb_owner:REDACTED_NEON_PASSWORD@REDACTED_NEON_HOST/neondb?sslmode=require"
JWT_SECRET="change-this-to-a-secure-secret-key"

# --------------------------------------------
# AI (OpenAI)
# --------------------------------------------
OPENAI_API_KEY="sk-proj-your-openai-key-here"

# --------------------------------------------
# FILE STORAGE (Cloudflare R2)
# --------------------------------------------
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="techcitta-videos"

# --------------------------------------------
# APP URL
# --------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --------------------------------------------
# SENTRY (Error Tracking)
# --------------------------------------------
SENTRY_DSN="https://your-sentry-dsn-here.ingest.us.sentry.io/your-project-id"

# --------------------------------------------
# UPSTASH REDIS (Rate Limiting)
# --------------------------------------------
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"

# --------------------------------------------
# INNGEST (Background Jobs)
# --------------------------------------------
INNGEST_EVENT_KEY="signkey-prod-your-key-here"

# --------------------------------------------
# SMTP (Email)
# --------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-smtp-password"

# --------------------------------------------
# LIVEKIT (Real-time WebRTC Video)
# --------------------------------------------
LIVEKIT_URL=wss://livekit.techcitta.com
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# --------------------------------------------
# DEEPGRAM (Server-side Transcription)
# --------------------------------------------
DEEPGRAM_API_KEY="your-deepgram-api-key"

# --------------------------------------------
# WHATSAPP BUSINESS API
# --------------------------------------------
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-number-id"
WHATSAPP_ACCESS_TOKEN="your-whatsapp-access-token"