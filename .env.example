# ============================================================
# Techcitta environment variables
# Copy to .env.local (dev) or set in your hosting provider (prod).
# ============================================================

# --- Database ---
# Local dev (used for running Prisma migrations locally):
DATABASE_URL="file:./dev.db"
# Production (Turso libsql URL):
TURSO_DATABASE_URL="libsql://your-db.turso.io"
TURSO_AUTH_TOKEN="your-turso-token"

# --- Auth ---
# Any long random string. Generate with: openssl rand -hex 32
JWT_SECRET="change-me"

# --- AI interviews (OpenAI) ---
# gpt-5-nano is used for the interviewer and evaluations.
# NOTE: this is the only service that incurs real usage cost.
OPENAI_API_KEY="sk-..."

# --- File / video storage ---
# Cloudflare R2 (free tier: 10GB storage, zero egress). Optional — if these are
# missing, the app falls back to local ./public/uploads (dev only).
# Get them: Cloudflare dashboard > R2 > Create bucket > Manage R2 API Tokens.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="techcitta-videos"

# --- App URL (used in email links) ---
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# --- Email (optional, used for interview reminders + verification) ---
# Uses SMTP. A free Gmail app password works (Google account > Security > App passwords).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@gmail.com"
SMTP_PASS="your-app-password"

# --- WhatsApp (optional) ---
# Meta WhatsApp Business API credentials. Omit to disable WhatsApp messages.
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_ACCESS_TOKEN="your-whatsapp-access-token"

# --- Stripe billing (optional) ---
# Enable plan upgrades in /settings. Get keys from https://dashboard.stripe.com/apikeys
# and create two recurring Prices in the Stripe dashboard (Products > your product > Add price).
# Put the Price IDs (not the product IDs) below.
STRIPE_SECRET_KEY="sk_test_..."
# Used to verify webhook events. Get it: Stripe dashboard > Developers > Webhooks.
# Endpoint: https://your-app.vercel.app/api/billing/webhook, events:
#   checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_PRO="price_..._pro"
STRIPE_PRICE_ENTERPRISE="price_..._enterprise"
