# ============================================
# TECHCITTA - Environment Variables
# ============================================
# Copy this file to .env and fill in your values.

# --------------------------------------------
# CORE
# --------------------------------------------
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-random-string"

# --------------------------------------------
# DATABASE (Turso / libSQL - Production)
# --------------------------------------------
TURSO_DATABASE_URL="libsql://your-db.turso.io"
TURSO_AUTH_TOKEN="your-turso-token"

# --------------------------------------------
# AI (OpenAI)
# --------------------------------------------
OPENAI_API_KEY="sk-..."

# --------------------------------------------
# FILE STORAGE (Cloudflare R2)
# --------------------------------------------
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="techcitta-videos"

# --------------------------------------------
# APP URL
# --------------------------------------------
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# --------------------------------------------
# SENTRY (Error Tracking)
# Get DSN from: https://sentry.io → Project Settings → Client Keys
# --------------------------------------------
SENTRY_DSN=""

# --------------------------------------------
# UPSTASH REDIS (Global Rate Limiting)
# Get from: https://upstash.com → Redis database → REST API
# --------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --------------------------------------------
# INNGEST (Background Jobs)
# Get Event Key from: https://inngest.com → Your App → Keys
# --------------------------------------------
INNGEST_EVENT_KEY=""

# --------------------------------------------
# CRISP (Live Chat)
# Get Website ID from: https://crisp.chat → Settings → Chatbox → Installation
# --------------------------------------------
NEXT_PUBLIC_CRISP_WEBSITE_ID=""

# --------------------------------------------
# SMTP (Email)
# --------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@gmail.com"
SMTP_PASS="your-app-password"

# --------------------------------------------
# WHATSAPP (Notifications)
# --------------------------------------------
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_ACCESS_TOKEN="your-whatsapp-access-token"

# --------------------------------------------
# STRIPE (Payments)
# --------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Pricing (create prices in Stripe Dashboard → Products)
STRIPE_PRICE_PRO="price_..._pro"
STRIPE_PRICE_ENTERPRISE="price_..._enterprise"

# Multi-currency prices
STRIPE_PRICE_PRO_USD="price_..._pro_usd"
STRIPE_PRICE_ENTERPRISE_USD="price_..._enterprise_usd"
STRIPE_PRICE_PRO_EUR="price_..._pro_eur"
STRIPE_PRICE_ENTERPRISE_EUR="price_..._enterprise_eur"
STRIPE_PRICE_PRO_INR="price_..._pro_inr"
STRIPE_PRICE_ENTERPRISE_INR="price_..._enterprise_inr"
STRIPE_PRICE_PRO_GBP="price_..._pro_gbp"
STRIPE_PRICE_ENTERPRISE_GBP="price_..._enterprise_gbp"
STRIPE_PRICE_PRO_AED="price_..._pro_aed"
STRIPE_PRICE_ENTERPRISE_AED="price_..._enterprise_aed"
STRIPE_PRICE_PRO_SGD="price_..._pro_sgd"
STRIPE_PRICE_ENTERPRISE_SGD="price_..._enterprise_sgd"
STRIPE_PRICE_PRO_CAD="price_..._pro_cad"
STRIPE_PRICE_ENTERPRISE_CAD="price_..._enterprise_cad"
STRIPE_PRICE_PRO_AUD="price_..._pro_aud"
STRIPE_PRICE_ENTERPRISE_AUD="price_..._enterprise_aud"

STRIPE_TAX_ENABLED="false"
