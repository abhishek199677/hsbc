# ============================================
# HireRight — Environment Variables
# Copy to .env and fill in your values
# ============================================

# ─── Database (Neon) ──────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ─── Auth ─────────────────────────────────────────
JWT_SECRET="your-production-secret-min-32-chars"

# ─── OpenAI ───────────────────────────────────────
OPENAI_API_KEY="sk-..."

# ─── LiveKit (Real-time voice/video) ──────────────
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="API..."
LIVEKIT_API_SECRET="..."

# ─── Deepgram (Speech-to-text) ────────────────────
DEEPGRAM_API_KEY="..."

# ─── Cloudflare R2 (File storage) ─────────────────
R2_ACCOUNT_ID="..."
R2_ACCESS_KEY_ID="..."
R2_SECRET_ACCESS_KEY="..."
R2_BUCKET_NAME="..."

# ─── Upstash Redis (Rate limiting) ────────────────
UPSTASH_REDIS_REST_URL="..."
UPSTASH_REDIS_REST_TOKEN="..."

# ─── Stripe (Billing) ─────────────────────────────
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Sentry (Error tracking) ──────────────────────
SENTRY_DSN="https://..."

# ─── Email (SMTP) ─────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="..."
SMTP_PASS="..."

# ─── Inngest (Background jobs) ────────────────────
INNGEST_EVENT_KEY="..."

# ─── Frontend URL (for CORS, callbacks) ───────────
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# ─── Vercel (Deployment — set in GitHub Secrets) ──
# VERCEL_TOKEN=""
# VERCEL_ORG_ID=""
# VERCEL_PROJECT_ID=""

# ─── Render (Deployment — set in GitHub Secrets) ──
# RENDER_DEPLOY_HOOK_BACKEND=""
# RENDER_DEPLOY_HOOK_EVALUATOR=""
# RENDER_DEPLOY_HOOK_ML=""

# ─── Koyeb (Agent deployment — set in Koyeb dashboard) ──
# NEXTJS_URL="https://your-domain.vercel.app"
# LIVEKIT_URL="wss://your-project.livekit.cloud"
