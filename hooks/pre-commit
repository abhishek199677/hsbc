#!/bin/sh
#
# Pre-commit hook: scan for leaked secrets before committing.
# Install: cp hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# This hook checks staged files for common secret patterns and blocks
# the commit if any are found. Rotate any leaked secrets immediately.

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo " Scanning staged files for secrets..."

# Patterns to detect (case-insensitive)
PATTERNS=(
  'sk-proj-[A-Za-z0-9]'
  'sk_live_[A-Za-z0-9]'
  'sk_test_[A-Za-z0-9]'
  'rk_live_[A-Za-z0-9]'
  'rk_test_[A-Za-z0-9]'
  'password\s*[:=]\s*["\x27][^"\x27]{8,}'
  'secret\s*[:=]\s*["\x27][^"\x27]{8,}'
  'api[_-]?key\s*[:=]\s*["\x27][^"\x27]{8,}'
  'PRIVATE KEY'
  'BEGIN RSA PRIVATE KEY'
  'BEGIN DSA PRIVATE KEY'
  'BEGIN EC PRIVATE KEY'
  'BEGIN OPENSSH PRIVATE KEY'
)

FOUND=0

# Get staged files (exclude deleted files and this hook itself)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d 2>/dev/null | grep -v "hooks/pre-commit")

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

for PATTERN in "${PATTERNS[@]}"; do
  MATCHES=$(echo "$STAGED_FILES" | xargs grep -l -i "$PATTERN" 2>/dev/null)
  if [ -n "$MATCHES" ]; then
    echo ""
    echo -e "${RED} Possible secret detected (pattern: $PATTERN)${NC}"
    echo "$MATCHES" | while read -r FILE; do
      echo "   $FILE"
    done
    FOUND=1
  fi
done

if [ "$FOUND" -eq 1 ]; then
  echo ""
  echo -e "${YELLOW} Commit blocked. Remove secrets before committing.${NC}"
  echo "   If this is a false positive, commit with --no-verify."
  echo ""
  exit 1
fi

echo " No secrets found."
exit 0
