generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Organization {
  id                    String    @id @default(uuid())
  name                  String
  slug                  String    @unique
  logoUrl               String?
  primaryColor          String    @default("#4f46e5")
  accentColor           String    @default("#7c3aed")
  isGovernment          Boolean   @default(false)
  plan                  String    @default("starter") // starter, pro, enterprise
  planStatus            String? // trialing, active, past_due, canceled, unpaid
  trialEndsAt           DateTime?
  stripeCustomerId      String?   @unique
  stripeSubscriptionId  String?   @unique
  stripePriceId         String?
  status                String    @default("active") // active, suspended
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  users                 User[]
}

model User {
  id                    String             @id @default(uuid())
  email                 String             @unique
  password              String
  name                  String?
  phone                 String?
  role                  String             @default("jobseeker") // jobseeker, employer, admin
  emailVerifiedAt       DateTime?
  organizationId        String
  organization          Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  profile               Profile?
  interview             Interview?
  verificationTokens    VerificationToken[]
}

model Profile {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Resume
  resumeUrl       String?
  resumeFileName  String?
  
  // About You
  aboutYou        String?
  whatDrivesYou   String?
  strengths       String?
  
  // Current Snapshot
  currentRole     String?
  totalExperience String?
  currentLocation String?
  noticePeriod    String?
  
  // Skills
  skills          String?
  currentCompany  String?
  education       String?
  
  // Preferences
  jobType         String?
  salaryRange     String?
  preferredLocation String?
  workMode        String?
  
  // Interview Preferences
  preferredDate   String?
  preferredTimeSlot String?
  timezone        String    @default("Asia/Kolkata")
  
  // Status
  step            Int       @default(1)
  isComplete      Boolean   @default(false)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model VerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  type      String // email_verification, password_reset
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Interview {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  date            String
  time            String
  timezone        String    @default("Asia/Kolkata")
  mode            String    @default("AI Video Interview")
  type            String    @default("Technical + Behavioral Assessment")
  duration        Int       @default(15)
  
  status          String    @default("scheduled") // scheduled, completed, cancelled

  // Video recording & evaluation
  videoUrl        String?
  captionUrl      String?
  transcript      String?
  evaluation      String?
  evaluationScore Float?

  // Proctoring (anti-cheating)
  proctoringReport  String? // JSON ProctoringReport
  proctoringFlags   Int     @default(0)
  proctoringStatus  String? // pass, review, fail, off
  
  emailSent       Boolean   @default(false)
  whatsappSent    Boolean   @default(false)
  
  // Reminder tracking
  reminder24hSent Boolean   @default(false)
  reminder1hSent  Boolean   @default(false)
  reminder15mSent Boolean   @default(false)
  reminderNowSent Boolean   @default(false)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
