generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// pgvector extension for vector similarity search
// Enable via: CREATE EXTENSION IF NOT EXISTS vector;

model Organization {
  id                    String    @id @default(uuid())
  name                  String
  slug                  String    @unique
  logoUrl               String?
  primaryColor          String    @default("#4f46e5")
  accentColor           String    @default("#7c3aed")
  isGovernment          Boolean   @default(false)
  plan                  String    @default("starter") // starter, pro, enterprise
  planStatus            String? // trialing, active, past_due, canceled, unpaid
  trialEndsAt           DateTime?
  stripeCustomerId      String?   @unique
  stripeSubscriptionId  String?   @unique
  stripePriceId         String?
  status                String    @default("active") // active, suspended
  onboardingCompleted   Boolean   @default(false)
  onboardingStep        Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  users                 User[]
  teamMembers           TeamMember[]
  jobs                  Job[]
}

model User {
  id                    String             @id @default(uuid())
  email                 String             @unique
  password              String
  name                  String?
  phone                 String?
  role                  String             @default("jobseeker") // jobseeker, employer, admin
  emailVerifiedAt       DateTime?
  twoFactorEnabled      Boolean            @default(false)
  twoFactorSecret       String?
  organizationId        String
  organization          Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  profile               Profile?
  interview             Interview?
  verificationTokens    VerificationToken[]
  teamMemberships       TeamMember[]
}

model TeamMember {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String       @default("member") // owner, admin, interviewer, member, viewer
  inviteToken    String?
  invitedAt      DateTime     @default(now())
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
}

model Profile {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Resume
  resumeUrl       String?
  resumeFileName  String?
  
  // About You
  aboutYou        String?
  whatDrivesYou   String?
  strengths       String?
  
  // Current Snapshot
  currentRole     String?
  totalExperience String?
  currentLocation String?
  noticePeriod    String?
  
  // Skills
  skills          String?
  currentCompany  String?
  education       String?
  
  // Preferences
  jobType         String?
  salaryRange     String?
  preferredLocation String?
  workMode        String?
  
  // Interview Preferences
  preferredDate   String?
  preferredTimeSlot String?
  timezone        String    @default("Asia/Kolkata")
  
  // Status
  step            Int       @default(1)
  isComplete      Boolean   @default(false)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model VerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  type      String // email_verification, password_reset
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Interview {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  date            String
  time            String
  timezone        String    @default("Asia/Kolkata")
  mode            String    @default("AI Video Interview")
  type            String    @default("Technical + Behavioral Assessment")
  duration        Int       @default(15)
  
  status          String    @default("scheduled") // scheduled, in_progress, completed, cancelled

  // Video recording & evaluation
  videoUrl        String?
  captionUrl      String?
  transcript      String?
  evaluation      String?
  evaluationScore Float?

  // Proctoring (anti-cheating)
  proctoringReport  String? // JSON ProctoringReport
  proctoringFlags   Int     @default(0)
  proctoringStatus  String? // pass, review, fail, off
  
  // LiveKit integration
  livekitRoomName  String?
  livekitToken     String?
  
  // Deepgram transcription
  deepgramJobId   String?
  audioUrl        String?
  
  emailSent       Boolean   @default(false)
  whatsappSent    Boolean   @default(false)
  
  // Reminder tracking
  reminder24hSent Boolean   @default(false)
  reminder1hSent  Boolean   @default(false)
  reminder15mSent Boolean   @default(false)
  reminderNowSent Boolean   @default(false)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Feedback {
  id        String   @id @default(uuid())
  type      String
  message   String
  email     String?
  userId    String?
  page      String?
  status    String   @default("open")
  createdAt DateTime @default(now())
}

model Job {
  id              String    @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  title           String
  description     String
  department      String?
  location        String?
  employmentType  String? // full-time, part-time, contract, internship
  experienceLevel String? // junior, mid, senior, lead, executive
  salaryMin       Int?
  salaryMax       Int?
  currency        String   @default("INR")
  
  // Required skills (comma-separated or JSON)
  requiredSkills  String?
  preferredSkills String?
  
  status          String    @default("active") // active, paused, closed, draft
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  matches         CandidateMatch[]
}

model CandidateMatch {
  id              String    @id @default(uuid())
  jobId           String
  job             Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId          String    // references User but no FK constraint to allow cross-tenant matching
  
  // Similarity scores
  semanticScore   Float     // cosine similarity from embeddings
  skillsScore     Float     // skills overlap score
  experienceScore Float     // experience level match
  overallScore    Float     // weighted combination
  
  // Match details
  matchedSkills   String?   // JSON array of matched skill strings
  missingSkills   String?   // JSON array of missing skill strings
  explanation     String?   // AI-generated explanation of match quality
  
  status          String    @default("suggested") // suggested, reviewed, shortlisted, rejected
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@unique([jobId, userId])
}

model TranscriptSegment {
  id              String    @id @default(uuid())
  interviewId     String
  
  speaker         String    // "candidate" | "ai_interviewer"
  text            String
  startMs         Int
  endMs           Int
  
  createdAt       DateTime  @default(now())
}
