# ─── Docker Compose Environment Variables ──────────────────────────────────────
# Copy this file to .env.deploy and fill in the values
# Usage: docker compose --env-file .env.deploy up -d

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://hsbc_admin:YOUR_PASSWORD@YOUR_RDS_ENDPOINT:5432/hsbcprod?sslmode=require

# ─── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=YOUR_RANDOM_64_CHAR_STRING

# ─── AI Services ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-YOUR_KEY

# ─── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ─── AWS S3 ────────────────────────────────────────────────────────────────────
S3_BUCKET=hsbc-prod-uploads
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY

# ─── Redis (Upstash or ElastiCache) ───────────────────────────────────────────
REDIS_URL=rediss://YOUR_REDIS_ENDPOINT:6379

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ─── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=https://YOUR_SENTRY_DSN

# ─── Cron ──────────────────────────────────────────────────────────────────────
CRON_SECRET=YOUR_CRON_SECRET
